# 默认大模型接口（OpenAI 兼容）。仅在「模型设置」中还没有任何接口时，首次启动会写入；之后以页面配置为准。
LLM_PROVIDER_NAME=默认接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
# 主模型与备用模型（主模型失败时自动切换）
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# 账号登录（多人共用的服务器上开启；本地自己用可以不开）
# AUTH_ENABLED=1
# 注册邀请码（初始值）：学生凭它自行注册；留空则关闭注册。管理员之后可在「模型设置」页面修改
# INVITE_CODE=
# 管理员（老师）账号：开启登录时每次启动按此创建或重置，只有管理员能修改模型设置、管理用户。
# 不开启登录时，设置 ADMIN_PASSWORD 则修改模型设置前需要在页面上输入它解锁
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 回测计算进程数（默认 2；0 表示在请求线程内直接计算）。多人同时使用时可以调大，每个进程约 300 MB 内存
# BACKTEST_WORKERS=2
