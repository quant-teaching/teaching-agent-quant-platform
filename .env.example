# 默认大模型接口（OpenAI 兼容）。仅在「模型设置」中还没有任何接口时，首次启动会写入；之后以页面配置为准。
LLM_PROVIDER_NAME=默认接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
# 主模型与备用模型（主模型失败时自动切换）
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# 账号登录（多人共用的服务器上开启；本地自己用可以不开）
# AUTH_ENABLED=1
# 教师注册码：老师凭它注册老师账号（留空则不开放老师注册，管理员可在「设置 → 注册设置」修改）
# TEACHER_INVITE_CODE=
# 旧版本的全局邀请码：首次启动时自动建「默认班级」并沿用它作为班级邀请码；新部署不需要设置
# INVITE_CODE=
# 管理员（老师）账号：开启登录时每次启动按此创建或重置，只有管理员能修改模型设置、管理用户。
# 不开启登录时，设置 ADMIN_PASSWORD 则修改模型设置前需要在页面上输入它解锁
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 回测计算进程数（默认 2；0 表示在请求线程内直接计算）。多人同时使用时可以调大，每个进程约 300 MB 内存
# BACKTEST_WORKERS=2
