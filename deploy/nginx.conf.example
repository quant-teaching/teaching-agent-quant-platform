# Nginx 反向代理示例（HTTPS）。把 quant.example.com 和证书路径换成自己的，放到 /etc/nginx/conf.d/ 下。
# 对外开放时请在平台的 .env 中开启账号登录（AUTH_ENABLED=1，见部署说明），由平台自己的登录页鉴权。

server {
    listen 80;
    server_name quant.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name quant.example.com;

    ssl_certificate     /etc/nginx/ssl/quant.example.com.fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/quant.example.com.key;

    client_max_body_size 2m;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 600s;

    # 智能体对话是 SSE 流式输出，必须关闭缓冲
    location /api/chat {
        proxy_pass http://127.0.0.1:8650;
        proxy_buffering off;
        proxy_cache off;
    }

    location / {
        proxy_pass http://127.0.0.1:8650;
        # 接口 JSON 已由应用压缩，这里只压缩静态资源
        gzip on;
        gzip_comp_level 5;
        gzip_min_length 1024;
        gzip_vary on;
        gzip_proxied any;
        gzip_types text/css application/javascript image/svg+xml;
    }
}
