# Nginx 反向代理示例：HTTPS + 访问密码。把 quant.example.com 和证书路径换成自己的，放到 /etc/nginx/conf.d/ 下。
# 平台本身没有登录功能，对外开放时务必保留 auth_basic。生成密码文件：
#   printf 'quant:%s\n' "$(openssl passwd -apr1 '你的密码')" > /etc/nginx/quant-platform.htpasswd
#   chown root:www-data /etc/nginx/quant-platform.htpasswd && chmod 640 /etc/nginx/quant-platform.htpasswd

server {
    listen 80;
    server_name quant.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name quant.example.com;

    ssl_certificate     /etc/nginx/ssl/quant.example.com.fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/quant.example.com.key;

    auth_basic           "量化策略教学平台";
    auth_basic_user_file /etc/nginx/quant-platform.htpasswd;

    client_max_body_size 2m;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 600s;

    # 智能体对话是 SSE 流式输出，必须关闭缓冲
    location /api/chat {
        proxy_pass http://127.0.0.1:8650;
        proxy_buffering off;
        proxy_cache off;
    }

    location / {
        proxy_pass http://127.0.0.1:8650;
        # 接口 JSON 已由应用压缩，这里只压缩静态资源
        gzip on;
        gzip_comp_level 5;
        gzip_min_length 1024;
        gzip_vary on;
        gzip_proxied any;
        gzip_types text/css application/javascript image/svg+xml;
    }
}
